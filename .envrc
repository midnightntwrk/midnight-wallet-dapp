# point out to users at commit time that commits need to be signed,
# not once they've done many commits and are trying to push a PR:
git config --local commit.gpgSign true
git config --local tag.gpgSign true

export COMPACTC_VERSION=0.34.0 # must be set to a valid version of compactc
export COMPACT_TAG_PREFIX=compactc-v # override default value
export COMPACT_ASSET_PREFIX=compactc_v # override default release asset prefix
export COMPACT_REPO=LFDT-Minokawa/compact # override default value

# Image tags for the hard-fork stack in compose.yml. Named apart from the
# PROOF_SERVER_VERSION / INDEXER_VERSION / MIDNIGHT_NODE_VERSION trio a
# single-era stack uses: this one pins two node images and two proof servers at
# once, so one of each would be unreachable under the shared names.
export FORK_FROM_NODE_TAG=1.0.1     # writes the genesis, so the chain starts on ledger v8
export NODE_TAG=2.1.0-beta.1        # the v9 binary, running that pre-fork chain
export INDEXER_TAG=4.4.0-rc.5
export PROOF_SERVER_TAG=9.0.0-rc.7  # post-fork (ledger v9)
export PROOF_SERVER_V8_TAG=8.1.2    # pre-fork (ledger v8)
export TOOLKIT_TAG=2.1.0-beta.1     # enacts the fork through governance

echo "COMPACTC_VERSION=${COMPACTC_VERSION}"
echo "COMPACT_TAG_PREFIX=${COMPACT_TAG_PREFIX}"
echo "COMPACT_ASSET_PREFIX=${COMPACT_ASSET_PREFIX}"
echo "COMPACT_REPO=${COMPACT_REPO}"
echo "FORK_FROM_NODE_TAG=${FORK_FROM_NODE_TAG}"
echo "NODE_TAG=${NODE_TAG}"
echo "INDEXER_TAG=${INDEXER_TAG}"
echo "PROOF_SERVER_TAG=${PROOF_SERVER_TAG}"
echo "PROOF_SERVER_V8_TAG=${PROOF_SERVER_V8_TAG}"
echo "TOOLKIT_TAG=${TOOLKIT_TAG}"
